<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

<ItemGroup><ProjectReference Include="../../src/Saintber.Assistant.Abstractions/Saintber.Assistant.Abstractions.csproj" /><ProjectReference Include="../../src/Saintber.Assistant.Connectors.Core/Saintber.Assistant.Connectors.Core.csproj" /><ProjectReference Include="../../src/Saintber.Assistant.Connectors.Line/Saintber.Assistant.Connectors.Line.csproj" /><ProjectReference Include="../../src/Saintber.Assistant.Host/Saintber.Assistant.Host.csproj" /></ItemGroup><ItemGroup><Compile Remove="Fixtures/**/*.cs" /></ItemGroup><Target Name="PublishConnectorTestFixtures" BeforeTargets="Build">
    <PropertyGroup><ConnectorFixtureOutput>$(MSBuildProjectDirectory)/Fixtures/published</ConnectorFixtureOutput></PropertyGroup>
    <RemoveDir Directories="$(ConnectorFixtureOutput)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/Fixtures/TestConnector/TestConnector.csproj&quot; -o &quot;$(ConnectorFixtureOutput)&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/Fixtures/WrongConnector/WrongConnector.csproj&quot; -o &quot;$(ConnectorFixtureOutput)/wrong&quot;" />
    <ItemGroup><ConnectorFixtureFiles Include="$(ConnectorFixtureOutput)/*" /></ItemGroup>
    <Copy SourceFiles="@(ConnectorFixtureFiles)" DestinationFolder="$(ConnectorFixtureOutput)/copy" />
  </Target>
  <Target Name="PublishLineConnectorTestFixture" BeforeTargets="Build" AfterTargets="PublishConnectorTestFixtures">
    <PropertyGroup><LineConnectorFixtureOutput>$(MSBuildProjectDirectory)/Fixtures/line_published</LineConnectorFixtureOutput></PropertyGroup>
    <RemoveDir Directories="$(LineConnectorFixtureOutput)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../../src/Saintber.Assistant.Connectors.Line/Saintber.Assistant.Connectors.Line.csproj&quot; -o &quot;$(LineConnectorFixtureOutput)&quot;" />
    <ItemGroup><LineConnectorFixtureFiles Include="$(LineConnectorFixtureOutput)/**/*" /></ItemGroup>
    <Copy SourceFiles="@(LineConnectorFixtureFiles)" DestinationFolder="$(LineConnectorFixtureOutput)/copy/%(RecursiveDir)" />
  </Target>
</Project>